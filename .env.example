# Public application metadata. NEXT_PUBLIC_ variables are embedded in the client bundle.
NEXT_PUBLIC_APP_NAME=GymFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only PostgreSQL connection used by Prisma. Replace placeholders locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct PostgreSQL connection used by Prisma CLI commands and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
