# Public application metadata. NEXT_PUBLIC_ variables are embedded in the client bundle.
NEXT_PUBLIC_APP_NAME=GymFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth project URL and browser-safe publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Keep service-role keys server-only. This app does not require one for normal auth.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Server-only PostgreSQL connection used by Prisma. Replace placeholders locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct PostgreSQL connection used by Prisma CLI commands and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
